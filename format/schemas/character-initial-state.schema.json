{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAIRN book character definitions and initial states",
  "description": "Character extension only; not a complete book or package schema. No defaults are applied.",
  "type": "object",
  "properties": {
    "initial-state": false,
    "heroes": {"type": "array", "items": {"$ref": "#/$defs/character"}},
    "npcs": {"type": "array", "items": {"$ref": "#/$defs/character"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "localized-text": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "kk": {"$ref": "#/$defs/text"},
            "ru": {"$ref": "#/$defs/text"},
            "en": {"$ref": "#/$defs/text"}
          }
        }
      ]
    },
    "count": {"type": "integer", "minimum": 0},
    "appearance-result": {"type": "integer", "minimum": 1, "maximum": 10},
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physique": {"$ref": "#/$defs/appearance-result"},
        "skin": {"$ref": "#/$defs/appearance-result"},
        "hair": {"$ref": "#/$defs/appearance-result"},
        "face": {"$ref": "#/$defs/appearance-result"},
        "clothing": {"$ref": "#/$defs/appearance-result"}
      }
    },
    "character": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/localized-text"},
        "description": {"$ref": "#/$defs/localized-text"},
        "notes": {"$ref": "#/$defs/localized-text"},
        "initial-state": {"$ref": "#/$defs/state"}
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {"$ref": "#/$defs/count"},
        "maximum": {"$ref": "#/$defs/count"}
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      },
      "dependentRequired": {"complete": ["items"]}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/localized-text"},
        "kind": {"enum": ["equipment", "book", "relic", "supply", "valuable"]},
        "quantity": {"$ref": "#/$defs/count"},
        "uses": {"$ref": "#/$defs/values"},
        "slots": {"type": "integer", "minimum": 0, "maximum": 2},
        "damage": {"$ref": "#/$defs/text"},
        "properties": {"$ref": "#/$defs/texts"},
        "notes": {"$ref": "#/$defs/localized-text"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      },
      "dependentRequired": {"complete": ["items"]}
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character-id": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/localized-text"},
        "kind": {"$ref": "#/$defs/text"},
        "notes": {"$ref": "#/$defs/localized-text"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age": {"$ref": "#/$defs/count", "description": "Age in completed years at entry into the story; omit if unknown or approximate."},
        "appearance": {"$ref": "#/$defs/appearance"},
        "abilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "str": {"$ref": "#/$defs/count"},
            "dex": {"$ref": "#/$defs/count"},
            "wil": {"$ref": "#/$defs/count"}
          }
        },
        "hp": {"$ref": "#/$defs/values"},
        "armor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {"type": "integer", "minimum": 0, "maximum": 3},
            "sources": {"$ref": "#/$defs/texts"}
          }
        },
        "inventory": {"$ref": "#/$defs/inventory"},
        "talisman": {
          "allOf": [
            {"$ref": "#/$defs/item"},
            {"properties": {"slots": {"const": 0}}}
          ]
        },
        "fatigue": {"$ref": "#/$defs/count"},
        "deprived": {"type": "boolean"},
        "critical-damage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {"type": "boolean"},
            "consequences": {"$ref": "#/$defs/texts"}
          }
        },
        "scars": {"$ref": "#/$defs/texts"},
        "features": {"$ref": "#/$defs/texts"},
        "words": {"$ref": "#/$defs/texts"},
        "companions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "complete": {"type": "boolean"},
            "items": {"type": "array", "items": {"$ref": "#/$defs/companion"}}
          },
          "dependentRequired": {"complete": ["items"]}
        }
      }
    }
  }
}
